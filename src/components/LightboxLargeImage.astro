---
/**
 * Featured image that opens the site lightbox (same URL as displayed).
 */
interface Props {
  /** Filename under public/images/ */
  src: string;
  alt: string;
  /** Tailwind classes for the <img> — include object-cover or object-contain, aspect, max-h, etc. */
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'auto' | 'async' | 'sync';
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  class: imgClass = 'object-cover',
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
  width,
  height,
} = Astro.props;
const href = `/images/${src}`;
---
<button
  type="button"
  class="block w-full cursor-zoom-in border-0 bg-transparent p-0 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)] rounded-lg"
  data-lightbox={href}
  data-lightbox-alt={alt}
  aria-label={`View larger: ${alt}`}
>
  <img
    src={href}
    alt=""
    width={width}
    height={height}
    fetchpriority={fetchpriority}
    loading={loading}
    decoding={decoding}
    class:list={['pointer-events-none w-full rounded-lg shadow-xl', imgClass]}
  />
</button>
