---
import { Image, getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  /** Filename under src/assets/images/ */
  src: string;
  alt: string;
  /** Tailwind classes for the <img> — include object-cover or object-contain, aspect, max-h, etc. */
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'auto' | 'async' | 'sync';
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  class: imgClass = 'object-cover',
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
  width,
  height,
} = Astro.props;

const imageMeta = await resolveImage(src);
const displayWidth = width ?? Math.min(imageMeta.width, 1200);
const full = await getImage({ src: imageMeta, width: Math.min(imageMeta.width, 1800) });
---
<button
  type="button"
  class="block w-full cursor-zoom-in border-0 bg-transparent p-0 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)] rounded-lg"
  data-lightbox={full.src}
  data-lightbox-alt={alt}
  aria-label={`View larger: ${alt}`}
>
  <Image
    src={imageMeta}
    alt=""
    width={displayWidth}
    height={height}
    loading={loading}
    decoding={decoding}
    class:list={['pointer-events-none w-full rounded-lg shadow-xl', imgClass]}
    {...(fetchpriority ? { fetchpriority } : {})}
  />
</button>
