---
/**
 * Full-width hero image that opens the site lightbox at full resolution (same URL as src).
 */
interface Props {
  /** Filename under public/images/ */
  src: string;
  alt: string;
  /** Tailwind classes for the <img> (layout, aspect, min-height, etc.) */
  class?: string;
}

const { src, alt, class: imgClass = '' } = Astro.props;
const href = `/images/${src}`;
---
<button
  type="button"
  class="block w-full cursor-zoom-in border-0 bg-transparent p-0 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)] rounded-lg"
  data-lightbox={href}
  data-lightbox-alt={alt}
  aria-label={`View larger: ${alt}`}
>
  <img
    src={href}
    alt=""
    class:list={['pointer-events-none w-full rounded-lg shadow-xl object-cover', imgClass]}
    loading="lazy"
  />
</button>
