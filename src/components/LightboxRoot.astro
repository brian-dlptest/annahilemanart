---
/**
 * Single dialog + delegated click handling for [data-lightbox] triggers sitewide.
 */
---
<dialog
  id="site-lightbox"
  class="site-lightbox max-h-[min(96vh,900px)] w-[min(96vw,1200px)] max-w-none border-0 bg-transparent p-0 shadow-none open:flex open:items-center open:justify-center"
  aria-modal="true"
  aria-label="Enlarged artwork"
>
  <div class="relative flex max-h-[min(96vh,900px)] w-full flex-col items-center justify-center">
    <button
      type="button"
      data-lightbox-close
      class="absolute -right-1 -top-10 z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-paper)] text-[color:var(--color-ink)] shadow-md ring-1 ring-black/15 transition hover:bg-black/5 md:-right-2 md:-top-12"
      aria-label="Close"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <img
      src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
      alt=""
      class="max-h-[min(85vh,860px)] w-auto max-w-full rounded object-contain shadow-2xl"
      data-lightbox-img
    />
    <p id="site-lightbox-caption" data-lightbox-caption class="mt-4 max-w-full text-center text-sm text-white/90 empty:hidden"></p>
  </div>
</dialog>

<script is:inline>
  (function () {
    function init() {
      var dialog = document.getElementById('site-lightbox');
      if (!dialog || dialog.dataset.lightboxBound === '1') return;
      dialog.dataset.lightboxBound = '1';

      var imgEl = dialog.querySelector('[data-lightbox-img]');
      var captionEl = dialog.querySelector('[data-lightbox-caption]');
      var closeBtn = dialog.querySelector('[data-lightbox-close]');

      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var trigger = t.closest('[data-lightbox]');
        if (!trigger) return;
        var src = trigger.getAttribute('data-lightbox');
        if (!src || !imgEl) return;
        e.preventDefault();
        var altText = trigger.getAttribute('data-lightbox-alt') || '';
        imgEl.src = src;
        imgEl.alt = altText;
        if (captionEl) {
          captionEl.textContent = altText;
        }
        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        }
      });

      function close() {
        if (typeof dialog.close === 'function') {
          dialog.close();
        }
      }

      if (closeBtn) {
        closeBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          close();
        });
      }

      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) {
          close();
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && dialog.open) {
          close();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
