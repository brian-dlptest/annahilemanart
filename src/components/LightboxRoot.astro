---
/**
 * Single dialog + delegated click handling for [data-lightbox] triggers sitewide.
 */
---
<dialog
  id="site-lightbox"
  class="site-lightbox"
  aria-modal="true"
  aria-label="Enlarged artwork"
>
  <div class="relative box-border mx-auto flex max-h-[min(92vh,900px)] w-[min(92vw,1200px)] max-w-[min(92vw,1200px)] flex-col items-center justify-center gap-3 overflow-hidden px-3 pb-3 pt-12 sm:px-4 sm:pb-4 sm:pt-14">
    <button
      type="button"
      data-lightbox-close
      class="absolute right-2 top-2 z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-paper)] text-[color:var(--color-ink)] shadow-md ring-1 ring-black/15 transition-colors hover:bg-red-600 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2 focus-visible:ring-offset-transparent sm:right-3 sm:top-3"
      aria-label="Close"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <img
      src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
      alt=""
      class="mx-auto max-h-[min(78vh,820px)] w-auto max-w-full rounded object-contain shadow-2xl"
      data-lightbox-img
    />
    <p id="site-lightbox-caption" data-lightbox-caption class="max-w-full shrink-0 text-center text-sm text-white/90 empty:hidden"></p>
  </div>
</dialog>

<script is:inline>
  (function () {
    function init() {
      var dialog = document.getElementById('site-lightbox');
      if (!dialog || dialog.dataset.lightboxBound === '1') return;
      dialog.dataset.lightboxBound = '1';

      var imgEl = dialog.querySelector('[data-lightbox-img]');
      var captionEl = dialog.querySelector('[data-lightbox-caption]');
      var closeBtn = dialog.querySelector('[data-lightbox-close]');

      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.closest) return;
        var trigger = t.closest('[data-lightbox]');
        if (!trigger) return;
        var src = trigger.getAttribute('data-lightbox');
        if (!src || !imgEl) return;
        e.preventDefault();
        var altText = trigger.getAttribute('data-lightbox-alt') || '';
        var captionText = trigger.hasAttribute('data-lightbox-caption')
          ? (trigger.getAttribute('data-lightbox-caption') || '')
          : altText;
        imgEl.src = src;
        imgEl.alt = altText;
        if (captionEl) {
          captionEl.textContent = captionText;
        }
        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
          document.documentElement.style.overflow = 'hidden';
          document.body.style.overflow = 'hidden';
        }
      });

      function close() {
        if (typeof dialog.close === 'function') {
          dialog.close();
        }
      }

      dialog.addEventListener('close', function () {
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          close();
        });
      }

      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) {
          close();
        }
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && dialog.open) {
          close();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
