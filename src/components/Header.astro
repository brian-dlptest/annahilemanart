---
const links = [
  { href: '/', label: 'Home' },
  { href: '/portraits', label: 'Pet Portraits' },
  { href: '/murals', label: 'Murals' },
  { href: '/garden-gems', label: 'Garden Gems' },
  { href: '/custom-artwork', label: 'Commercial' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const { pathname } = Astro.url;
---
<header class="sticky top-0 z-40 bg-[color:var(--color-paper)]/90 backdrop-blur border-b border-black/5">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 flex items-center justify-between h-20">
    <a href="/" class="flex items-baseline gap-2">
      <span class="font-display text-2xl tracking-tight">Anna Hileman</span>
      <span class="text-xs uppercase tracking-[0.2em] text-[color:var(--color-accent)]">Art</span>
    </a>
    <nav class="hidden lg:flex items-center gap-8">
      {links.map(link => (
        <a
          href={link.href}
          class={`text-sm tracking-wide transition-colors ${pathname === link.href ? 'text-[color:var(--color-ink)] font-medium' : 'text-[color:var(--color-ink)]/60 hover:text-[color:var(--color-ink)]'}`}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <details class="lg:hidden relative">
      <summary class="list-none cursor-pointer p-2">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </summary>
      <nav class="absolute right-0 mt-2 w-56 bg-[color:var(--color-paper)] border border-black/10 rounded shadow-lg py-2">
        {links.map(link => (
          <a href={link.href} class="block px-4 py-2 text-sm hover:bg-black/5">
            {link.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
