---
interface Props {
  src?: string;
  alt: string;
  class?: string;
  ratio?: 'square' | 'portrait' | 'landscape' | 'wide';
}

const { src, alt, class: cls = '', ratio = 'square' } = Astro.props;

const ratioClass = {
  square: 'aspect-square',
  portrait: 'aspect-[3/4]',
  landscape: 'aspect-[4/3]',
  wide: 'aspect-[16/9]',
}[ratio];

// Use a real image if provided, otherwise placeholder
const imageSrc = src ? `/images/${src}` : null;
---
<div class={`${ratioClass} ${cls} overflow-hidden bg-[color:var(--color-accent-soft)] placeholder-art`}>
  {imageSrc && (
    <img
      src={imageSrc}
      alt={alt}
      class="w-full h-full object-cover"
      loading="lazy"
    />
  )}
  {!imageSrc && (
    <div class="w-full h-full flex items-center justify-center relative">
      <div class="font-display text-[color:var(--color-accent)]/70 text-center px-4 relative z-10">
        <div class="text-xs uppercase tracking-[0.2em] mb-2">Artwork</div>
        <div class="text-sm">{alt}</div>
      </div>
    </div>
  )}
</div>
