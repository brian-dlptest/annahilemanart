---
import { Image, getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  src?: string;
  alt: string;
  class?: string;
  ratio?: 'square' | 'portrait' | 'landscape' | 'wide';
  /** When true, click opens a full-size view. Default true. Set false for nav cards or non-gallery use. */
  lightbox?: boolean;
  /** Responsive sizes attribute to pair with native browser lazy loading. */
  sizes?: string;
}

const {
  src,
  alt,
  class: cls = '',
  ratio = 'square',
  lightbox = true,
  sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
} = Astro.props;

const ratioClass = {
  square: 'aspect-square',
  portrait: 'aspect-[3/4]',
  landscape: 'aspect-[4/3]',
  wide: 'aspect-[16/9]',
}[ratio];

const displayWidth = {
  square: 800,
  portrait: 800,
  landscape: 900,
  wide: 1200,
}[ratio];

const imageMeta = src ? await resolveImage(src) : null;
const lightboxOn = Boolean(lightbox && imageMeta);

let lightboxSrc: string | undefined;
if (lightboxOn && imageMeta) {
  const full = await getImage({ src: imageMeta, width: Math.min(imageMeta.width, 1800) });
  lightboxSrc = full.src;
}

const shellClass = `${ratioClass} ${cls} overflow-hidden bg-[color:var(--color-accent-soft)] placeholder-art`;
const triggerClass = `${shellClass} block w-full cursor-zoom-in border-0 p-0 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]`;
---

{lightboxOn && imageMeta ? (
  <button
    type="button"
    class={triggerClass}
    data-lightbox={lightboxSrc}
    data-lightbox-alt={alt}
    aria-label={`View larger: ${alt}`}
  >
    <Image
      src={imageMeta}
      alt={alt}
      width={displayWidth}
      sizes={sizes}
      class="pointer-events-none h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
  </button>
) : (
  <div class={shellClass}>
    {imageMeta && (
      <Image
        src={imageMeta}
        alt={alt}
        width={displayWidth}
        sizes={sizes}
        class="h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    )}
    {!imageMeta && (
      <div class="relative z-10 flex h-full w-full items-center justify-center">
        <div class="relative z-10 px-4 text-center font-display text-[color:var(--color-accent)]/70">
          <div class="mb-2 text-xs uppercase tracking-[0.2em]">Artwork</div>
          <div class="text-sm">{alt}</div>
        </div>
      </div>
    )}
  </div>
)}
