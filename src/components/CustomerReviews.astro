---
import {
  customerReviews,
  googleReviewAttributions,
  googleReviewStats,
  googleReviewsProfileUrl,
  type CustomerReview,
} from '../data/customer-reviews';

function initials(name: string): string {
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length >= 2) {
    return (parts[0]![0]! + parts[parts.length - 1]![0]!).toUpperCase();
  }
  return name.slice(0, 2).toUpperCase();
}

function cardStarCount(review: CustomerReview): number {
  const n = Math.round(review.starRating ?? 5);
  return Math.min(5, Math.max(1, n));
}

const profileUrl = googleReviewsProfileUrl.trim();
const hasProfileLink = profileUrl.length > 0;

const googleWordmarkSvg = `<svg class="h-7 w-auto" viewBox="0 0 74 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill="#4285F4" d="M9.24 8.19v2.46h5.88c-.18 1.38-.74 2.52-1.57 3.32l3.54 2.76c2.07-1.92 3.28-4.74 3.28-8.09 0-.78-.08-1.53-.22-2.26h-5.41z"/><path fill="#34A853" d="M9.24 15.09c-1.62 0-3.06-.56-4.21-1.66l-3.22 2.51c1.73 1.36 3.95 2.21 6.43 2.21 1.94 0 3.55-.65 4.73-1.76l-3.54-2.76c-.98.66-2.23 1.06-3.19 1.06z"/><path fill="#FBBC05" d="M4.03 12.71c-.25-.66-.39-1.38-.39-2.11s.14-1.45.39-2.11L.77 6.48C.28 7.45 0 8.59 0 9.6s.28 2.15.77 3.12l3.26-2.01z"/><path fill="#EA4335" d="M9.24 4.07c1.09 0 2.09.38 2.86 1.12l2.14-2.14C13.25 1.49 11.45.8 9.24.8 6.76.8 4.54 1.65 2.81 3.01l3.22 2.51c1.15-1.1 2.59-1.45 4.21-1.45z"/><text x="26" y="17" fill="#4285F4" font-family="system-ui,sans-serif" font-size="14" font-weight="500">Google</text></svg>`;
---

<section class="border-t border-black/10 bg-white" aria-labelledby="customer-reviews-heading">
  <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20">
    <h2 id="customer-reviews-heading" class="font-display text-4xl text-center mb-14">
      Customer Reviews
    </h2>

    <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-start">
      <div class="lg:col-span-3 text-center lg:text-left">
        <p class="text-lg font-semibold tracking-wide uppercase text-[color:var(--color-ink)]">
          {googleReviewStats.ratingLabel}
        </p>
        <div class="mt-3 flex justify-center lg:justify-start gap-0.5" aria-hidden="true">
          {Array.from({ length: googleReviewStats.starCount }).map(() => (
            <svg class="h-6 w-6 text-[#fbbc04]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
            </svg>
          ))}
        </div>
        <p class="mt-4 text-sm text-black/60">
          Based on {googleReviewStats.totalReviewCount} reviews
        </p>
        <div class="mt-6 flex justify-center lg:justify-start">
          {
            hasProfileLink ? (
              <a
                href={profileUrl}
                class="inline-block opacity-90 hover:opacity-100 transition-opacity"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Read reviews on Google"
                set:html={googleWordmarkSvg}
              ></a>
            ) : (
              <span class="inline-block opacity-90" set:html={googleWordmarkSvg} aria-hidden="true"></span>
            )
          }
        </div>
      </div>

      <div class="lg:col-span-9 relative min-w-0">
        <button
          type="button"
          class="customer-reviews__prev absolute left-0 top-1/2 z-10 -translate-y-1/2 -translate-x-1 lg:-translate-x-4 flex h-10 w-10 items-center justify-center rounded-full border border-black/15 bg-white text-lg text-black/70 shadow-sm hover:border-black/30 hover:bg-black/[0.02] transition-colors disabled:opacity-30 disabled:pointer-events-none"
          aria-label="Show previous reviews"
          data-reviews-prev
        >
          &#8249;
        </button>
        <button
          type="button"
          class="customer-reviews__next absolute right-0 top-1/2 z-10 -translate-y-1/2 translate-x-1 lg:translate-x-4 flex h-10 w-10 items-center justify-center rounded-full border border-black/15 bg-white text-lg text-black/70 shadow-sm hover:border-black/30 hover:bg-black/[0.02] transition-colors disabled:opacity-30 disabled:pointer-events-none"
          aria-label="Show next reviews"
          data-reviews-next
        >
          &#8250;
        </button>

        <div
          class="customer-reviews__scroller flex gap-4 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-2 pl-12 pr-12 lg:pl-14 lg:pr-14 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          tabindex="0"
          role="region"
          aria-label="Review cards"
          data-reviews-scroller
        >
          {customerReviews.map((review) => (
            <article
              class="customer-reviews__card snap-start shrink-0 w-[min(100%,min(360px,calc(100vw-6rem)))] rounded-lg border border-black/10 bg-[color:var(--color-paper)] p-5 shadow-sm flex flex-col"
              data-review-card
            >
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <div
                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-accent-soft)] text-sm font-semibold text-[color:var(--color-ink)]"
                    aria-hidden="true"
                  >
                    {initials(review.name)}
                  </div>
                  <div class="min-w-0">
                    <p class="font-medium text-[color:var(--color-ink)] truncate">{review.name}</p>
                    <p class="text-xs text-black/50">{review.relativeTime}</p>
                  </div>
                </div>
                <svg class="h-5 w-5 shrink-0 opacity-70" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill="#4285F4"
                    d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                  />
                  <path
                    fill="#34A853"
                    d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                  />
                  <path
                    fill="#EA4335"
                    d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                  />
                </svg>
              </div>

              <div class="mt-4 flex items-center gap-2">
                <div class="flex gap-0.5" aria-hidden="true">
                  {Array.from({ length: cardStarCount(review) }).map(() => (
                    <svg class="h-4 w-4 text-[#fbbc04]" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                    </svg>
                  ))}
                </div>
                <span
                  class="inline-flex items-center justify-center rounded-full bg-[#1a73e8]/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-[#1a73e8]"
                  title="Verified review"
                >
                  Verified
                </span>
              </div>

              <div class="mt-3 flex-1 min-h-0" data-review-expandable>
                <p class="customer-reviews__text text-sm text-black/75 leading-relaxed line-clamp-4">
                  {review.text}
                </p>
                <button
                  type="button"
                  class="customer-reviews__toggle mt-2 text-sm font-medium text-[#1a73e8] hover:underline text-left hidden"
                  data-review-toggle
                  aria-expanded="false"
                >
                  Read more
                </button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>

    {
      googleReviewAttributions.length > 0 && (
        <div class="mt-12 border-t border-black/10 pt-8 text-center text-xs text-black/50 space-y-2 [&_a]:underline">
          {googleReviewAttributions.map((html) => (
            <p set:html={html} />
          ))}
        </div>
      )
    }
  </div>
</section>

<script is:inline>
  (function () {
    const section = document.querySelector('[aria-labelledby="customer-reviews-heading"]');
    if (!section) return;

    const scroller = section.querySelector('[data-reviews-scroller]');
    const prev = section.querySelector('[data-reviews-prev]');
    const next = section.querySelector('[data-reviews-next]');
    if (!scroller || !prev || !next) return;

    const getStep = function () {
      const card = scroller.querySelector('[data-review-card]');
      if (!card) return scroller.clientWidth;
      return card.offsetWidth + 16;
    };

    const syncArrows = function () {
      var maxScroll = scroller.scrollWidth - scroller.clientWidth;
      var eps = 2;
      prev.disabled = scroller.scrollLeft <= eps;
      next.disabled = scroller.scrollLeft >= maxScroll - eps;
    };

    prev.addEventListener('click', function () {
      scroller.scrollBy({ left: -getStep(), behavior: 'smooth' });
    });
    next.addEventListener('click', function () {
      scroller.scrollBy({ left: getStep(), behavior: 'smooth' });
    });
    scroller.addEventListener('scroll', syncArrows, { passive: true });
    window.addEventListener('resize', syncArrows);
    syncArrows();

    section.querySelectorAll('[data-review-expandable]').forEach(function (wrap) {
      var textEl = wrap.querySelector('.customer-reviews__text');
      var btn = wrap.querySelector('[data-review-toggle]');
      if (!textEl || !btn) return;

      requestAnimationFrame(function () {
        if (textEl.scrollHeight > textEl.clientHeight + 2) {
          btn.classList.remove('hidden');
        }
      });

      btn.addEventListener('click', function () {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        if (expanded) {
          textEl.classList.add('line-clamp-4');
          btn.setAttribute('aria-expanded', 'false');
          btn.textContent = 'Read more';
        } else {
          textEl.classList.remove('line-clamp-4');
          btn.setAttribute('aria-expanded', 'true');
          btn.textContent = 'Read less';
        }
      });
    });
  })();
</script>
