---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';
import JsonLd from '../components/JsonLd.astro';
import { buildBreadcrumbs } from '../data/schemas';

const aboutBreadcrumbs = buildBreadcrumbs(Astro.site, [
  { name: 'Home', slug: '' },
  { name: 'About', slug: 'about' },
]);

const siteOrigin = Astro.site ? Astro.site.origin : 'https://annahileman.com';

// Press mention: 5280 Magazine on Threefold Bakery — surfaces Anna's work in structured data
// so search engines and LLMs can attribute the press quote to the business entity.
const pressMentionSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: 'Threefold Bakery in Breckenridge named the Best Road-Trip Restaurant by 5280 Magazine',
  url: 'https://5280.com/threefold-bakery-in-breckenridge-named-the-best-road-trip-restaurant-by-5280-magazine/',
  publisher: {
    '@type': 'Organization',
    name: '5280 Magazine',
    url: 'https://5280.com/',
  },
  about: { '@id': `${siteOrigin}/#business` },
  mentions: [
    { '@id': `${siteOrigin}/#person` },
    { '@id': `${siteOrigin}/#business` },
  ],
};

const bodyOfWork = [
  {
    title: 'School Murals',
    tagline: 'Hallways that tell the story of a place.',
    image: 'Dual-Immersion-Academy-School-Mural-8.jpg',
    href: '/school-murals',
  },
  {
    title: 'Restaurants & Interiors',
    tagline: 'Commissioned work for hospitality spaces.',
    image: 'Threefold-Bakery-Interior-Mural-by-Anna-Hileman-Courtesy1600.jpeg',
    href: '/restaurants',
  },
  {
    title: 'Pet Portraits',
    tagline: 'Paintings of the ones you love.',
    image: 'Pet-Portrait-Featured-Acrylic-on-Aluminum.jpg',
    href: '/pet-portraits',
  },
  {
    title: 'Garden Gems',
    tagline: 'Botanical acrylic panels, rooted in meaning.',
    image: 'Johannas-Garden-Gem-Full-Edited.jpg',
    href: '/garden-gems',
  },
];

const annaHeroImg = await resolveImage('anna-about-mural-portrait.jpg');
const studioImg = await resolveImage('Studio.jpg');
const magLogoImg = await resolveImage('5280-Mag-Logo.png');
const threefoldPressImg = await resolveImage('Threefold-Bakery-Interior-Mural-by-Anna-Hileman-Courtesy1600.jpeg');
const ogImg = await getImage({ src: annaHeroImg, width: 1200, format: 'jpeg' });

const resolvedBodyOfWork = await Promise.all(
  bodyOfWork.map(async (w) => ({
    ...w,
    resolvedImg: await resolveImage(w.image),
  })),
);
---
<Layout
  title="About Anna Hileman — Colorado Muralist & Commercial Artist"
  description="Meet Anna Hileman, a Colorado-based artist creating hand-painted murals, pet portraits, and commercial artwork for restaurants, schools, and collectors across Denver and the Front Range."
  ogImage={ogImg.src}
  ogImageAlt="Portrait of Colorado artist Anna Hileman"
  preloadImage={annaHeroImg.src}
>
  <!-- Editorial hero: large portrait photo + name block -->
  <section class="border-b border-black/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-6 min-w-0">
          <Image
            src={annaHeroImg}
            alt="Anna Hileman in her Colorado studio"
            width={1024}
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="w-full rounded-lg shadow-2xl object-cover aspect-[3/4]"
          />
        </div>
        <div class="lg:col-span-6">
          <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">
            Artist &middot; Muralist &middot; Colorado
          </div>
          <h1 class="mt-6 font-display text-5xl md:text-6xl lg:text-8xl leading-[0.95] text-[color:var(--color-ink)]">
            Anna
            <span class="block italic text-[color:var(--color-gold)]">Hileman.</span>
          </h1>
          <p class="mt-8 text-xl lg:text-2xl text-black/75 leading-relaxed font-display max-w-lg">
            Story-driven artwork shaped by place, meaning, and the lives of the people who live with it.
          </p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 bg-[color:var(--color-gold)] text-[color:var(--color-ink)] px-8 py-4 text-sm tracking-wide hover:bg-[color:var(--color-ink)] hover:text-[color:var(--color-gold)] transition-colors"
            >
              Start a Conversation
              <span aria-hidden="true">&rarr;</span>
            </a>
            <a
              href="#work"
              class="inline-flex items-center gap-2 border border-[color:var(--color-ink)]/20 text-[color:var(--color-ink)] px-8 py-4 text-sm tracking-wide hover:border-[color:var(--color-ink)] transition-colors"
            >
              See the Work
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Signature quote band -->
  <section class="bg-[color:var(--color-ink)] text-[color:var(--color-paper)]">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-24 lg:py-32 text-center">
      <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">
        Working Principle
      </div>
      <blockquote class="mt-8 font-display text-3xl md:text-5xl lg:text-6xl leading-[1.1] italic max-w-4xl mx-auto">
        &ldquo;Art shaped by place, meaning, and
        {' '}
        <span class="text-[color:var(--color-gold)]">story.</span>&rdquo;
      </blockquote>
    </div>
  </section>

  <!-- Bio essay + studio image -->
  <section class="border-b border-black/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-7">
          <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)] mb-6">
            The Short Version
          </div>
          <div class="font-display text-xl md:text-2xl leading-relaxed text-[color:var(--color-ink)] space-y-6">
            <p>
              <span class="float-left font-display text-7xl leading-[0.8] mr-3 mt-1 text-[color:var(--color-gold)]">A</span>nna Hileman is a Colorado-based muralist and commercial artist creating custom, story-driven artwork for schools, restaurants, and homes.
            </p>
          </div>
          <div class="mt-8 space-y-5 text-base md:text-lg leading-relaxed text-black/75">
            <p>
              Through <strong class="text-[color:var(--color-ink)]">Anna Hileman Art LLC</strong>, she offers full concept-to-completion services&mdash;design, on-site mockups, installation, and delivery&mdash;for residential, commercial, and educational spaces.
            </p>
            <p>
              In addition to murals, Anna creates <em>Garden Gems</em>, vibrant floral and plant-inspired acrylic panels featuring her signature style, and commissioned pet portraits in oil and acrylic.
            </p>
            <p>
              With a BFA in Interior Design and Fine Art, she collaborates closely with every client to weave their values, stories, and sense of place into the work. Each school mural is accompanied by an original poem written for the piece.
            </p>
          </div>
        </div>
        <div class="lg:col-span-5">
          <figure>
            <Image
              src={studioImg}
              alt="Anna Hileman's studio, with works in progress"
              width={1024}
              loading="lazy"
              decoding="async"
              class="w-full rounded-lg shadow-xl object-cover aspect-[4/3]"
            />
            <figcaption class="mt-4 text-xs uppercase tracking-[0.25em] text-black/50">
              The Studio &middot; Colorado
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- Body of work grid -->
  <section id="work" class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
    <div class="max-w-2xl mb-14">
      <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">
        Bodies of Work
      </div>
      <h2 class="mt-4 font-display text-3xl md:text-5xl">Four portfolios, one hand.</h2>
      <p class="mt-6 text-black/70 leading-relaxed">
        Each body of work has its own voice, but they share a common approach: listen first, design around the place, paint with intention.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-10">
      {resolvedBodyOfWork.map((w) => (
        <a
          href={w.href}
          class="group relative block overflow-hidden rounded-lg aspect-[4/3] bg-black/5"
        >
          <Image
            src={w.resolvedImg}
            alt=""
            width={1024}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent" aria-hidden="true"></div>
          <div class="absolute inset-x-0 bottom-0 p-6 lg:p-8 text-white">
            <div class="text-[10px] uppercase tracking-[0.3em] text-[color:var(--color-gold)]">
              Portfolio
            </div>
            <h3 class="mt-2 font-display text-2xl md:text-3xl">{w.title}</h3>
            <p class="mt-2 text-sm text-white/85 max-w-sm">{w.tagline}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-xs uppercase tracking-[0.25em] text-[color:var(--color-gold)]">
              View &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Press / In Print -->
  <section class="border-y border-black/10 bg-[color:var(--color-accent-soft)]/25">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-28">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">
          Publications &amp; Press
        </div>
        <h2 class="mt-4 font-display text-3xl md:text-5xl">In Print.</h2>
      </div>

      <article class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-7">
          <Image
            src={threefoldPressImg}
            alt="Threefold Bakery interior mural in Breckenridge, Colorado, by Anna Hileman"
            width={1024}
            loading="lazy"
            decoding="async"
            class="w-full rounded-lg shadow-xl object-cover aspect-[16/9]"
          />
        </div>
        <div class="lg:col-span-5">
          <Image
            src={magLogoImg}
            alt="5280 Magazine"
            width={200}
            loading="lazy"
            class="h-10 w-auto mb-6"
          />
          <div class="text-xs uppercase tracking-[0.25em] text-black/50">
            Road-Trip Restaurant
          </div>
          <h3 class="mt-3 font-display text-2xl md:text-3xl">
            Threefold Bakery, Breckenridge.
          </h3>
          <blockquote class="mt-6 font-display italic text-lg text-black/80 border-l-2 border-[color:var(--color-gold)] pl-6 leading-relaxed">
            &ldquo;The name Threefold refers to the French technique of tri-folding croissant dough, and Anna&rsquo;s mural captures the bakery&rsquo;s origin story in a sweeping interior piece.&rdquo;
          </blockquote>
          <a
            href="https://5280.com/threefold-bakery-in-breckenridge-named-the-best-road-trip-restaurant-by-5280-magazine/"
            class="mt-8 inline-flex items-center gap-2 text-sm uppercase tracking-[0.2em] border-b border-[color:var(--color-ink)] pb-1 hover:text-[color:var(--color-gold)] hover:border-[color:var(--color-gold)] transition-colors"
            target="_blank"
            rel="noopener"
          >
            Read the Article
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- Credentials strip -->
  <section class="border-b border-black/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-14">
        <div>
          <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">
            Education
          </div>
          <div class="mt-4 font-display text-xl md:text-2xl text-[color:var(--color-ink)]">
            BFA, Interior Design &amp; Fine Art
          </div>
        </div>
        <div>
          <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">
            Studio
          </div>
          <div class="mt-4 font-display text-xl md:text-2xl text-[color:var(--color-ink)]">
            Anna Hileman Art LLC
          </div>
          <div class="mt-1 text-sm text-black/60">Residential, commercial, and educational commissions</div>
        </div>
        <div>
          <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">
            Based In
          </div>
          <div class="mt-4 font-display text-xl md:text-2xl text-[color:var(--color-ink)]">
            Colorado
          </div>
          <div class="mt-1 text-sm text-black/60">Available for commissions nationwide</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-[color:var(--color-accent-soft)]/25">
    <div class="max-w-3xl mx-auto px-6 lg:px-10 py-16 lg:py-24 text-center">
      <h2 class="font-display text-3xl md:text-4xl">Have a wall, a space, or a face in mind?</h2>
      <p class="mt-4 text-black/70">Tell me about it. Every piece begins with a conversation.</p>
      <a
        href="/contact"
        class="mt-10 inline-flex items-center gap-2 bg-[color:var(--color-gold)] text-[color:var(--color-ink)] px-8 py-4 text-sm tracking-wide hover:bg-[color:var(--color-ink)] hover:text-[color:var(--color-gold)] transition-colors"
      >
        Start a Conversation
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
  <JsonLd json={aboutBreadcrumbs} />
  <JsonLd json={pressMentionSchema} />
</Layout>
