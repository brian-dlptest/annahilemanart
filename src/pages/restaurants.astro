---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';
import LightboxThumb from '../components/LightboxThumb.astro';
import LightboxLargeImage from '../components/LightboxLargeImage.astro';
import JsonLd from '../components/JsonLd.astro';
import { buildServiceSchema, buildBreadcrumbs } from '../data/schemas';

const threefoldHeroImg = await resolveImage('Threefold-Bakery-Interior-Mural-by-Anna-Hileman-Courtesy1600.jpeg');
const restaurantsServiceSchema = buildServiceSchema(Astro.site, {
  name: 'Custom Restaurant Artwork & Murals',
  slug: 'restaurants',
  description:
    'Hand-painted murals and custom artwork for Denver and Colorado restaurants — featured at Threefold Bakery, Radicato, Quality Italian, and more.',
  serviceType: 'Commercial mural commissions',
  image: threefoldHeroImg.src,
});
const restaurantsBreadcrumbs = buildBreadcrumbs(Astro.site, [
  { name: 'Home', slug: '' },
  { name: 'Restaurant Art', slug: 'restaurants' },
]);

const processSteps = [
  {
    eyebrow: '01 · Concept',
    title: 'Story-first creative direction',
    body:
      "We begin by understanding the restaurant's character, menu philosophy, and guest experience goals before defining the visual narrative.",
  },
  {
    eyebrow: '02 · Mockup',
    title: 'Site-specific composition',
    body:
      'Measurements, wall conditions, and lighting are reviewed. Then artwork concepts are superimposed onto your space so you can approve with confidence.',
  },
  {
    eyebrow: '03 · Install',
    title: 'Professional execution',
    body:
      'Artwork is produced and installed with care, clear communication, and minimal interruption to day-to-day restaurant operations.',
  },
] as const;

const threefoldThumbs = [
  'Threefold-Bakery-Mural-1.jpg',
  'Threefold-Bakery-Mural-2.jpg',
  'Threefold-Bakery-Mural-3.jpg',
  'Threefold-Bakery-Mural.jpg',
  'Threefold-Mural-Panel-1.jpg',
  'Threefold-Mural-Panel-2.jpg',
  'Threefold-Bakery-Mural-Mid-Panel.jpg',
] as const;

const radicatoThumbs = [
  'IMG_9457.jpg',
  'IMG_5993.jpeg',
  'IMG_6522.jpeg',
  'IMG_9456.jpg',
  'IMG_9AD7D0E25CDB-1.jpeg',
  'IMG_6516.jpeg',
  'IMG_6515.jpeg',
  'IMG_6514.jpeg',
  'IMG_6120.jpeg',
  'IMG_6508.jpeg',
  'IMG_6480.jpeg',
  'IMG_6495-3.jpeg',
  'IMG_6488-2.jpeg',
  'IMG_6483.jpeg',
  'IMG_6123.jpeg',
  'IMG_6510-1.jpeg',
  'IMG_6496.jpeg',
  'IMG_6498.jpeg',
  'IMG_6506.jpeg',
  'RenderedImage.jpg',
] as const;

const qiThumbs = [
  'QI_Lion-Head.jpg',
  'PLASTER-AND-RESIN-LION-HEAD_QUALITY-ITALIAN_DENVER.jpg',
  'PROCESS-RESTAURANT-DOORS-QI.jpg',
  'GOLD-LEAF-DETAIL.jpg',
  'GOLD-LEAF-MORE-DETAIL.jpg',
  'QI-Exterior.jpg',
  'HALCYON-HOTEL-DENVER-.jpg',
  'EXTERIOR-SIGNAGE.jpg',
  '2016-11-16-00.06.01.jpg',
  '2016-12-01-23.09.48.jpg',
] as const;

const ogImg = await getImage({ src: threefoldHeroImg, width: 1200, format: 'jpeg' });
---

<Layout
  title="Custom Restaurant Artwork & Murals | Anna Hileman Art"
  description="Hand-painted murals and custom artwork for Denver and Colorado restaurants by artist Anna Hileman. Featured installations at Threefold Bakery, Radicato, Quality Italian, and more."
  ogImage={ogImg.src}
  ogImageAlt="Threefold Bakery interior mural hand-painted by Anna Hileman"
  preloadImage={threefoldHeroImg.src}
>
  <section class="border-b border-black/5">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start lg:items-center">
        <div class="order-2 lg:order-1 lg:col-span-5 min-w-0">
          <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">Hospitality Commissions</div>
          <h1 class="mt-6 font-display text-4xl md:text-5xl lg:text-6xl leading-[1.05] text-[color:var(--color-ink)]">
            Restaurant art that
            <br />
            <em class="italic text-[color:var(--color-gold)]">holds the room.</em>
          </h1>
          <p class="mt-8 text-lg text-black/75 leading-relaxed max-w-lg">
            Site-specific murals and installations designed to deepen atmosphere, reflect brand identity,
            and create memorable guest experiences.
          </p>
          <a
            href="/contact"
            class="mt-10 inline-flex items-center gap-2 bg-[color:var(--color-gold)] text-[color:var(--color-ink)] px-8 py-4 text-sm tracking-wide hover:bg-[color:var(--color-ink)] hover:text-[color:var(--color-gold)] transition-colors"
          >
            Start a Restaurant Project
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="order-1 lg:order-2 lg:col-span-7 min-w-0">
          <LightboxLargeImage
            src="Threefold-Bakery-Interior-Mural-by-Anna-Hileman-Courtesy1600.jpeg"
            alt="Threefold Bakery interior mural by Anna Hileman"
            width={1600}
            height={2000}
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="h-auto max-h-[min(82vh,900px)] object-contain bg-black/[0.03] ring-1 ring-black/5"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-[color:var(--color-accent-soft)]/40 border-y border-black/5">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-20 lg:py-24">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
        {processSteps.map((step) => (
          <div>
            <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-gold)]">{step.eyebrow}</div>
            <h3 class="mt-3 font-display text-xl md:text-2xl">{step.title}</h3>
            <p class="mt-3 text-sm text-black/70 leading-relaxed">{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-black/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
      <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-12">
        <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">Case Study</div>
        <h2 class="mt-4 font-display text-4xl lg:text-5xl">Threefold Bakery</h2>
        <p class="mt-2 text-sm font-semibold tracking-wide text-black/80">Breckenridge, Colorado</p>
      </div>
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">
        <div class="space-y-8 min-w-0">
          <div class="text-black/80 leading-relaxed text-[15px] md:text-base">
            <p>
              This custom mural tells a story of origin, movement, and convergence. A sandhill crane travels from sea to mountain,
              echoing the paths of the three owners whose lives in California and Colorado came together to build Threefold.
            </p>
            <p class="mt-4">
              Bramble vines, hummingbirds, and fruiting forms represent growth, care, and abundance. Gold accents move through a bright,
              vintage rainbow palette to reflect the spirit of indigen: being deeply rooted in place, craft, and community.
            </p>
          </div>
          <div class="grid grid-cols-3 gap-2">
            {threefoldThumbs.map((src) => (
              <LightboxThumb src={src} alt="Threefold Bakery mural detail" />
            ))}
          </div>
        </div>
        <div class="lg:sticky lg:top-28">
          <LightboxLargeImage
            src="Threefold-Bakery-Interior-Mural-by-Anna-Hileman-Courtesy1600.jpeg"
            alt="Threefold Bakery interior mural by Anna Hileman"
            width={1600}
            height={2000}
            class="aspect-[3/4] object-cover lg:min-h-[min(85vh,52rem)]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-black/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
      <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-12">
        <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">Case Study</div>
        <h2 class="mt-4 font-display text-4xl lg:text-5xl">Radicato</h2>
        <p class="mt-2 text-sm font-semibold tracking-wide text-black/80">Breckenridge, Colorado</p>
      </div>
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">
        <div class="space-y-8 min-w-0">
          <div class="text-black/80 leading-relaxed text-[15px] md:text-base">
            <p>
              Radicato features a curated collection of commissioned works created specifically for its interior. The collection explores what it
              means to be rooted in place, process, and people.
            </p>
            <p class="mt-4">
              Materials including gold leaf, alcohol ink, acrylic, wire, and layered butcher paper introduce depth and tactility. The collection is
              anchored by a 10-foot Garden Gem installation that reflects origin, nourishment, and what lies beneath the surface.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
            {radicatoThumbs.map((src) => (
              <LightboxThumb src={src} alt="Radicato commissioned artwork" />
            ))}
          </div>
        </div>
        <div class="lg:sticky lg:top-28 space-y-6">
          <LightboxLargeImage
            src="IMG_9457.jpg"
            alt="Radicato, Breckenridge commissioned restaurant artwork"
            class="aspect-[3/4] object-cover"
          />
          <LightboxLargeImage
            src="IMG_6126.jpeg"
            alt="Radicato restaurant interior and artwork"
            class="aspect-[3/4] object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-black/10 pb-20 lg:pb-24">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
      <div class="text-center max-w-3xl mx-auto mb-10 lg:mb-12">
        <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">Case Study</div>
        <h2 class="mt-4 font-display text-4xl lg:text-5xl">Quality Italian</h2>
        <p class="mt-2 text-sm font-semibold tracking-wide text-black/80">Cherry Creek, Colorado</p>
      </div>
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">
        <div class="space-y-8 min-w-0">
          <div class="text-black/80 leading-relaxed text-[15px] md:text-base">
            <p>
              For Quality Italian, Anna hand-designed and hand-painted a custom dining-room ceiling composed of over one hundred individual painted
              components assembled on site into a cohesive immersive installation.
            </p>
            <p class="mt-4">
              The project also included custom lion artwork with a marble-like finish and gold-leaf detailing on glass doors, extending the material
              language and craftsmanship across the full guest environment.
            </p>
          </div>
          <div class="grid grid-cols-3 gap-2">
            {qiThumbs.map((src) => (
              <LightboxThumb src={src} alt="Quality Italian restaurant artwork" />
            ))}
          </div>
        </div>
        <div class="lg:sticky lg:top-28">
          <LightboxLargeImage
            src="QI-Ceiling.jpg"
            alt="Quality Italian Cherry Creek dining room with custom hand-painted ceiling"
            class="aspect-[3/4] object-cover lg:min-h-[min(85vh,52rem)]"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-black/10 bg-[color:var(--color-accent-soft)]/25">
    <div class="max-w-3xl mx-auto px-6 lg:px-10 py-16 lg:py-20 text-center">
      <h2 class="font-display text-3xl md:text-4xl">Ready to commission restaurant artwork?</h2>
      <p class="mt-4 text-black/70">Share your concept, timeline, and space details. Anna will help shape the direction.</p>
      <a
        href="/contact"
        class="mt-10 inline-flex items-center gap-2 bg-[color:var(--color-gold)] text-[color:var(--color-ink)] px-8 py-4 text-sm tracking-wide hover:bg-[color:var(--color-ink)] hover:text-[color:var(--color-gold)] transition-colors"
      >
        Contact Anna
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
  <JsonLd json={restaurantsServiceSchema} />
  <JsonLd json={restaurantsBreadcrumbs} />
</Layout>
