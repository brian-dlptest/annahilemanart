---
import Layout from '../layouts/Layout.astro';
import ArtImage from '../components/ArtImage.astro';
---
<Layout title="Restaurant Art | Anna Hileman Art">
  <section class="max-w-7xl mx-auto px-6 lg:px-10 py-20">
    <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-accent)] mb-6">For Hospitality</div>
    <h1 class="font-display text-5xl lg:text-6xl max-w-3xl">Custom Restaurant Art</h1>
    <p class="mt-8 text-lg text-black/70 max-w-2xl leading-relaxed">
      Full art collections designed for culinary destinations. Every piece is created for its
      placement, its story, and the experience guests carry home.
    </p>
  </section>

  <section class="max-w-7xl mx-auto px-6 lg:px-10 pb-24 space-y-24">
    <article class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        <ArtImage src="Threefold-Bakery-Interior-Mural-by-Anna-Hileman-Courtesy1600.jpeg" alt="Threefold Bakery mural" ratio="landscape" />
      </div>
      <div class="lg:col-span-5">
        <div class="text-xs uppercase tracking-[0.2em] text-black/40 mb-3">Breckenridge, Colorado</div>
        <h2 class="font-display text-4xl">Threefold Bakery</h2>
        <p class="mt-6 text-black/70 leading-relaxed">
          The custom artwork at Threefold Bakery tells a story of origin, movement, and coming
          together. A sandhill crane flies from one end of the bakery to the other, weaving the
          space into a single narrative.
        </p>
      </div>
    </article>

    <article class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-center">
      <div class="lg:col-span-5 lg:order-1">
        <div class="text-xs uppercase tracking-[0.2em] text-black/40 mb-3">Breckenridge, Colorado</div>
        <h2 class="font-display text-4xl">Radicato</h2>
        <p class="mt-6 text-black/70 leading-relaxed">
          A culinary destination and recipient of a James Beard Award. This body of work
          comprises 13 custom pieces of art, each created specifically for its placement
          within the restaurant.
        </p>
      </div>
      <div class="lg:col-span-7 lg:order-2">
        <ArtImage src="IMG_5993.jpeg" alt="Radicato artwork" ratio="landscape" />
      </div>
    </article>
  </section>
</Layout>
