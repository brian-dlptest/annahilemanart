---
import Layout from '../layouts/Layout.astro';
---
<Layout title="News & Updates | Anna Hileman Art">
  <section class="max-w-4xl mx-auto px-6 lg:px-10 py-20">
    <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-accent)] mb-6">News</div>
    <h1 class="font-display text-5xl lg:text-6xl">Recent News &amp; Updates</h1>
    <p class="mt-8 text-lg text-black/70 max-w-2xl leading-relaxed">
      Project announcements, press features, and behind-the-scenes from the studio.
      Follow <a href="https://www.instagram.com/annahilemanart/" target="_blank" rel="noopener" class="underline">@annahilemanart on Instagram</a> for day-to-day updates.
    </p>

    <article class="mt-16 border-t border-black/10 pt-10">
      <div class="text-xs uppercase tracking-[0.2em] text-black/40 mb-3">February 2026</div>
      <h2 class="font-display text-3xl mb-4">From Story to Surface: How Personal Narratives Shape Every Piece</h2>
      <p class="text-black/70 leading-relaxed">
        Every painting begins with a conversation. Whether it's a pet portrait, a mural, or a
        Garden Gem, the story of the person it's made for always shapes the work.
      </p>
    </article>

    <article class="mt-10 border-t border-black/10 pt-10">
      <div class="text-xs uppercase tracking-[0.2em] text-black/40 mb-3">Press, 5280 Magazine</div>
      <h2 class="font-display text-3xl mb-4">Threefold Bakery Named Best Road-Trip Restaurant</h2>
      <p class="text-black/70 leading-relaxed">
        5280 Magazine featured Threefold Bakery in Breckenridge, including the custom interior
        mural created for the space.
      </p>
      <a href="https://5280.com/threefold-bakery-in-breckenridge-named-the-best-road-trip-restaurant-by-5280-magazine/"
         class="mt-4 inline-block text-sm uppercase tracking-wider border-b border-[color:var(--color-ink)] pb-0.5 hover:text-[color:var(--color-accent)] hover:border-[color:var(--color-accent)]"
         target="_blank" rel="noopener">Read the article</a>
    </article>
  </section>
</Layout>
