---
import Layout from '../layouts/Layout.astro';

/** Formspree form id (public in HTML). Override with PUBLIC_FORMSPREE_FORM_ID if you replace the form. */
const formspreeFormId = (import.meta.env.PUBLIC_FORMSPREE_FORM_ID || '').trim() || 'mqewbgqp';
const formAction = `https://formspree.io/f/${formspreeFormId}`;
---
<Layout
  title="Order a Custom Pet Portrait | Anna Hileman Art"
  description="Commission a custom hand-painted pet portrait in acrylic or oil from Colorado artist Anna Hileman. Simple order form, thoughtful process, heirloom-quality result."
>
  <article class="max-w-3xl mx-auto px-6 lg:px-10 py-20">
    <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-accent)] mb-6">Commission</div>
    <h1 class="font-display text-5xl mb-8">Order a Pet Portrait</h1>
    <p class="text-lg text-black/70 leading-relaxed mb-10">
      Fill out the form below and Anna will reach out within a few business days to discuss
      sizing, reference photos, and timeline. For questions, see the <a href="/pet-portraits" class="underline">portrait styles and pricing</a> page.
    </p>

    <form action={formAction} method="POST" class="space-y-8 bg-white border border-black/10 rounded-lg p-8 lg:p-10 shadow-sm">
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" />
      <div>
        <label class="block text-sm font-medium mb-2">Your name</label>
        <input name="name" type="text" required class="w-full border border-black/15 rounded px-3 py-2 focus:outline-none focus:border-[color:var(--color-accent)]" />
      </div>
      <div>
        <label class="block text-sm font-medium mb-2">Email</label>
        <input name="email" type="email" required class="w-full border border-black/15 rounded px-3 py-2 focus:outline-none focus:border-[color:var(--color-accent)]" />
      </div>
      <div>
        <label class="block text-sm font-medium mb-2">Pet's name</label>
        <input name="pet_name" type="text" class="w-full border border-black/15 rounded px-3 py-2 focus:outline-none focus:border-[color:var(--color-accent)]" />
      </div>
      <div>
        <label class="block text-sm font-medium mb-2">Preferred medium</label>
        <select name="medium" class="w-full border border-black/15 rounded px-3 py-2 focus:outline-none focus:border-[color:var(--color-accent)]">
          <option>Acrylic on Aluminum</option>
          <option>Oil on Linen Canvas</option>
          <option>Undecided, need advice</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium mb-2">Size</label>
        <select name="size" class="w-full border border-black/15 rounded px-3 py-2 focus:outline-none focus:border-[color:var(--color-accent)]">
          <option>20" x 20"</option>
          <option>24" x 24"</option>
          <option>30" x 30"</option>
          <option>24" x 36"</option>
          <option>36" x 36"</option>
          <option>Other / not sure</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium mb-2">Shipping needed?</label>
        <div class="flex gap-6 text-sm">
          <label class="flex items-center gap-2">
            <input name="shipping" type="radio" value="yes" /> Yes
          </label>
          <label class="flex items-center gap-2">
            <input name="shipping" type="radio" value="no" /> No, local pickup
          </label>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium mb-2">Tell me about your pet</label>
        <textarea name="message" rows="5" class="w-full border border-black/15 rounded px-3 py-2 focus:outline-none focus:border-[color:var(--color-accent)]" placeholder="Personality, favorite things, any special story..."></textarea>
      </div>
      <button type="submit" class="w-full bg-[color:var(--color-ink)] text-[color:var(--color-paper)] py-4 tracking-wide hover:bg-[color:var(--color-accent)] transition-colors">
        Send Commission Request
      </button>
      <p class="text-xs text-black/50 text-center">
        You can also email <a class="underline" href="mailto:annahilemanart@gmail.com">annahilemanart@gmail.com</a>.
      </p>
    </form>
  </article>
</Layout>
