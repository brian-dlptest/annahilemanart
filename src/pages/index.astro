---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getImage } from 'astro:assets';
import { resolveImage } from '../lib/images';
import ArtImage from '../components/ArtImage.astro';
import CustomerReviews from '../components/CustomerReviews.astro';

const heroImg = await resolveImage('Threefold-Bakery-Interior-Mural-by-Anna-Hileman-Courtesy1600.jpeg');
const annaImg = await resolveImage('anna-headshot-2026.jpg');
const ogImg = await getImage({ src: heroImg, width: 1200, format: 'jpeg' });

const featuredWorks = [
  {
    href: '/restaurants',
    title: 'Restaurant Art',
    blurb:
      'Commissioned mural systems and art collections for hospitality spaces that want atmosphere, story, and visual identity in one voice.',
    img: 'Threefold-Bakery-Interior-Mural-by-Anna-Hileman-Courtesy1600.jpeg',
    location: 'Breckenridge + Denver projects',
  },
  {
    href: '/garden-gems',
    title: 'Garden Gems',
    blurb:
      'Plant-inspired acrylic originals on hand-built panels. Each piece is custom and rooted in your symbolism, palette, and space.',
    img: 'Johannas-Garden-Gem-Full-Edited.jpg',
    location: 'Custom commissions',
  },
  {
    href: '/school-murals',
    title: 'School Murals',
    blurb:
      'Large-scale educational murals developed with schools to reflect values, mascots, and local identity for students and families.',
    img: 'Dual-Immersion-Academy-School-Mural-8.jpg',
    location: 'Grand Junction + Clifton',
  },
] as const;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What types of custom artwork does Anna Hileman create?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Anna creates commissioned restaurant artwork, school murals, pet portraits, and custom botanical panel pieces known as Garden Gems.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where is Anna Hileman based?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Anna is a Colorado muralist and commercial artist based in the Grand Junction area, serving clients across Colorado and beyond.',
      },
    },
    {
      '@type': 'Question',
      name: 'How does the commission process work?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Projects begin with a consultation, continue through concept development and mockups, and conclude with professional creation and installation or delivery.',
      },
    },
  ],
};
---
<Layout
  title="Anna Hileman Art | Colorado Muralist, Restaurant & School Artist"
  description="Custom murals, restaurant artwork, school murals, pet portraits, and botanical commissions by Colorado artist Anna Hileman. Serving Denver, Boulder, Breckenridge, Grand Junction, and the Front Range."
  ogImage={ogImg.src}
  ogImageAlt="Threefold Bakery interior mural in Breckenridge, Colorado, by Anna Hileman"
  preloadImage={heroImg.src}
>
  <section class="border-b border-black/5">
    <div class="max-w-[92rem] mx-auto px-6 lg:px-10 pt-16 pb-24 lg:pt-24 lg:pb-32">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-14 items-start lg:items-center">
        <div class="lg:col-span-8 min-w-0 flex justify-center lg:justify-start">
          <Image
            src={heroImg}
            alt="Restaurant interior mural by Colorado artist Anna Hileman"
            width={1800}
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="w-full max-w-full h-auto rounded-lg shadow-xl object-contain"
          />
        </div>
        <div class="lg:col-span-4 lg:pt-2">
          <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)] mb-6">
            Colorado Muralist &amp; Commercial Artist
          </div>
          <h1 class="font-display text-5xl lg:text-6xl leading-[1.05] text-[color:var(--color-ink)]">
            Custom artwork
            <br />
            <em class="italic text-[color:var(--color-gold)]">for places that want to be remembered.</em>
          </h1>
          <p class="mt-8 text-lg text-black/70 max-w-lg leading-relaxed">
            Anna Hileman creates story-driven murals and commissioned artwork for restaurants,
            schools, and private collectors. Based in Colorado, she designs each piece to reflect identity,
            atmosphere, and the people who live with it.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href="/contact" class="inline-flex items-center gap-2 bg-[color:var(--color-gold)] text-[color:var(--color-ink)] px-7 py-4 text-sm tracking-wide hover:bg-[color:var(--color-ink)] hover:text-[color:var(--color-gold)] transition-colors">
              Start a Commission
              <span>&rarr;</span>
            </a>
            <a href="/garden-gems" class="inline-flex items-center gap-2 border border-[color:var(--color-ink)]/30 px-6 py-3 text-sm tracking-wide hover:border-[color:var(--color-ink)] transition-colors">
              View Garden Gems
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="studio-section border-y border-black/5">
    <div class="studio-section__inner">
      <div class="studio-section__eyebrow">
        <div class="studio-section__rule" aria-hidden="true"></div>
        <div class="studio-section__kicker">From the studio</div>
      </div>

      <div class="studio-section__quote">
        <p class="studio-section__quote-lead">Great art for a space does more than decorate.</p>
        <p class="studio-section__quote-sub">
          It creates belonging, visual memory, and says something true about who you are.
        </p>
      </div>

      <div class="studio-process">
        <div class="studio-process__grid">
          <div class="studio-step">
            <div class="studio-step__icon">
              <svg
                class="studio-step__icon-svg studio-step__icon-svg--line"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  d="M6 10a6 6 0 0 1 12 0c0 3-2 4-3 5s-1 2-1 3a2 2 0 0 1-4 0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
                <path
                  d="M10 10a2 2 0 1 1 4 0c0 1.5-2 1.5-2 3"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <div class="studio-step__numeral" aria-hidden="true">01</div>
            <div class="studio-step__label">Listen</div>
            <h3 class="studio-step__title">Your story comes first.</h3>
            <p class="studio-step__body">
              We start with your space, audience, and intention so the work feels native to where it lives.
            </p>
          </div>

          <div class="studio-step">
            <div class="studio-step__icon">
              <svg
                class="studio-step__icon-svg studio-step__icon-svg--solid"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path fill="currentColor" d="M4 20h4l10-10-4-4L4 16v4z"></path>
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  d="M14 6l4 4"></path>
              </svg>
            </div>
            <div class="studio-step__numeral" aria-hidden="true">02</div>
            <div class="studio-step__label">Design</div>
            <h3 class="studio-step__title">Concepts with clear direction.</h3>
            <p class="studio-step__body">
              Mockups, palette planning, and composition shaped around architecture and flow.
            </p>
          </div>

          <div class="studio-step">
            <div class="studio-step__icon">
              <svg
                class="studio-step__icon-svg studio-step__icon-svg--solid"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path fill="currentColor" d="M14 4l6 6-9 9H5v-6l9-9z"></path>
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 19c-1 1-2 1-3 2 1-1 1-2 2-3"></path>
              </svg>
            </div>
            <div class="studio-step__numeral" aria-hidden="true">03</div>
            <div class="studio-step__label">Create</div>
            <h3 class="studio-step__title">Built to last and felt daily.</h3>
            <p class="studio-step__body">
              Every piece is produced with craftsmanship, installed carefully, and made for long-term impact.
            </p>
          </div>
        </div>
      </div>

      <div class="studio-section__cta">
        <a href="/contact">Start a project</a>
      </div>
    </div>
  </section>

  <style>
    .studio-section {
      --studio-step-gold: color-mix(in srgb, var(--color-gold) 68%, var(--color-ink) 32%);
      background: color-mix(in srgb, var(--color-accent-soft) 58%, var(--color-paper) 42%);
      padding: 6rem 2rem 5rem;
      font-family: var(--font-display), Georgia, 'Times New Roman', serif;
      color: var(--color-ink);
      text-align: center;
    }

    .studio-section__inner {
      max-width: 980px;
      margin: 0 auto;
    }

    .studio-section__eyebrow {
      margin-bottom: 2.5rem;
    }

    .studio-section__rule {
      width: 40px;
      height: 1px;
      background: var(--studio-step-gold);
      margin: 0 auto 18px;
    }

    .studio-section__kicker {
      font-size: 12px;
      letter-spacing: 0.28em;
      color: var(--studio-step-gold);
      text-transform: uppercase;
      font-weight: 400;
    }

    .studio-section__quote {
      max-width: 640px;
      margin: 0 auto 4.5rem;
    }

    .studio-section__quote-lead {
      font-size: clamp(28px, 3.4vw, 38px);
      line-height: 1.35;
      font-weight: 400;
      margin: 0 0 18px;
      color: var(--color-ink);
    }

    .studio-section__quote-sub {
      font-size: clamp(16px, 1.5vw, 19px);
      line-height: 1.6;
      font-style: italic;
      color: var(--color-accent);
      margin: 0;
      font-family: var(--font-display), Georgia, serif;
    }

    .studio-process {
      position: relative;
      max-width: 880px;
      margin: 0 auto;
    }

    .studio-process::before {
      content: '';
      position: absolute;
      top: 36px;
      left: 16%;
      right: 16%;
      height: 1px;
      background: var(--color-gold);
      opacity: 0.35;
      z-index: 0;
    }

    .studio-process__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
      position: relative;
      z-index: 1;
    }

    .studio-step {
      text-align: center;
      padding: 0 8px;
    }

    .studio-step__icon {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: color-mix(in srgb, var(--color-accent-soft) 58%, var(--color-paper) 42%);
      border: 1px solid var(--studio-step-gold);
      margin: 0 auto 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--studio-step-gold);
    }

    .studio-step__icon svg {
      width: 30px;
      height: 30px;
      color: var(--studio-step-gold);
    }

    .studio-step__icon-svg--line path {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .studio-step__icon-svg--solid path[fill='currentColor'] {
      fill: currentColor;
    }

    .studio-step__icon-svg--solid path[fill='none'] {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .studio-step__numeral {
      font-size: 56px;
      font-weight: 400;
      color: var(--studio-step-gold);
      line-height: 1;
      margin-bottom: 6px;
      font-family: var(--font-display), Georgia, serif;
    }

    .studio-step__label {
      font-size: 11px;
      letter-spacing: 0.22em;
      color: var(--studio-step-gold);
      text-transform: uppercase;
      margin-bottom: 14px;
      font-family: var(--font-display), Georgia, serif;
    }

    .studio-step__title {
      font-size: 20px;
      font-weight: 500;
      margin: 0 0 10px;
      line-height: 1.3;
      color: var(--color-ink);
      font-family: var(--font-display), Georgia, serif;
    }

    .studio-step__body {
      font-size: 15px;
      line-height: 1.6;
      color: var(--color-accent);
      margin: 0;
      max-width: 240px;
      margin-left: auto;
      margin-right: auto;
      font-family: var(--font-body), system-ui, sans-serif;
    }

    .studio-section__cta {
      margin-top: 4rem;
    }

    .studio-section__cta a {
      display: inline-block;
      padding: 14px 36px;
      border: 1px solid var(--studio-step-gold);
      color: var(--studio-step-gold);
      font-size: 12px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      text-decoration: none;
      font-family: var(--font-display), Georgia, serif;
      transition:
        background 0.25s ease,
        color 0.25s ease;
    }

    .studio-section__cta a:hover {
      background: var(--studio-step-gold);
      color: var(--color-paper);
    }

    @media (max-width: 720px) {
      .studio-section {
        padding: 4rem 1.5rem 3.5rem;
      }

      .studio-process::before {
        display: none;
      }

      .studio-process__grid {
        grid-template-columns: 1fr;
        gap: 48px;
      }
    }
  </style>

  <section class="border-t border-black/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20 lg:py-24">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">Featured Work</div>
        <h2 class="mt-4 font-display text-3xl md:text-4xl">Explore Signature Collections</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredWorks.map((item) => (
          <a href={item.href} class="group block">
            <article class="bg-[color:var(--color-accent-soft)]/10 border border-black/5 rounded-lg p-3 lg:p-4">
              <ArtImage alt={item.title} src={item.img} ratio="portrait" class="group-hover:opacity-90 transition-opacity rounded-md" lightbox={false} />
            </article>
            <div class="mt-4">
              <h3 class="font-display text-2xl group-hover:text-[color:var(--color-accent)] transition-colors">{item.title}</h3>
              <p class="mt-2 text-xs uppercase tracking-[0.2em] text-black/50">{item.location}</p>
              <p class="mt-3 text-sm text-black/65 leading-relaxed">{item.blurb}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CustomerReviews />

  <section class="border-t border-black/10">
    <div class="max-w-6xl mx-auto px-6 lg:px-10 py-20 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
        <div class="max-w-[320px] md:max-w-[380px] lg:max-w-[420px] mx-auto lg:mx-0">
          <Image
            src={annaImg}
            alt="Anna Hileman, Colorado muralist and commercial artist"
            width={600}
            loading="lazy"
            decoding="async"
            class="w-full rounded-lg object-cover aspect-[3/4] shadow-lg"
          />
        </div>
        <article class="bg-[color:var(--color-accent-soft)]/20 border border-black/5 rounded-lg p-8 lg:p-10">
          <div class="text-xs uppercase tracking-[0.25em] text-[color:var(--color-gold)]">About the Artist</div>
          <h2 class="mt-3 font-display text-3xl md:text-4xl">Colorado-based, collaboration-driven</h2>
          <p class="mt-5 text-black/75 leading-relaxed">
            Anna Hileman is a Colorado muralist and commercial artist known for emotionally resonant, place-based commissions.
            Her work spans restaurant interiors, school murals, private collections, and branded environments.
          </p>
          <p class="mt-4 text-black/75 leading-relaxed">
            Each project is built through close collaboration with clients, translating narrative and identity into color, form, and scale.
          </p>
          <a href="/about" class="mt-8 inline-flex items-center gap-2 text-sm uppercase tracking-[0.18em] border-b border-[color:var(--color-ink)] pb-1 hover:text-[color:var(--color-accent)] hover:border-[color:var(--color-accent)] transition-colors">
            Read Full Bio
            <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-[color:var(--color-accent-soft)]/30 border-y border-black/5">
    <div class="max-w-4xl mx-auto px-6 lg:px-10 py-16 lg:py-20">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-gold)]">FAQ</div>
        <h2 class="mt-4 font-display text-3xl md:text-4xl">Frequently Asked Questions</h2>
      </div>
      <div class="space-y-4">
        <details class="group bg-white/80 border border-black/10 rounded-lg p-5">
          <summary class="cursor-pointer list-none font-display text-xl flex items-center justify-between gap-4">
            What types of artwork can I commission?
            <span class="text-black/40 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-3 text-black/70 leading-relaxed text-sm md:text-base">
            Commissions include restaurant artwork, school murals, Garden Gems botanical panels, and custom pet portraits.
            If you have a different concept, you can still reach out to discuss feasibility and timeline.
          </p>
        </details>
        <details class="group bg-white/80 border border-black/10 rounded-lg p-5">
          <summary class="cursor-pointer list-none font-display text-xl flex items-center justify-between gap-4">
            Do you only work in Colorado?
            <span class="text-black/40 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-3 text-black/70 leading-relaxed text-sm md:text-base">
            Anna is based in Grand Junction, Colorado, and regularly serves clients throughout Colorado, including
            Denver, Breckenridge, and surrounding communities. Out-of-state projects are also considered, and any
            shipping costs will be confirmed during the quoting process.
          </p>
        </details>
        <details class="group bg-white/80 border border-black/10 rounded-lg p-5">
          <summary class="cursor-pointer list-none font-display text-xl flex items-center justify-between gap-4">
            How do we start a project?
            <span class="text-black/40 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-3 text-black/70 leading-relaxed text-sm md:text-base">
            Start by sharing your location, project type, timeline, and inspiration through the contact form.
            From there, Anna will guide consultation, concepting, and next steps.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 lg:px-10 py-20 lg:py-24 text-center">
    <h2 class="font-display text-4xl lg:text-5xl">Anna is currently accepting commercial and residential commissions upon request.</h2>
    <a href="/contact" class="mt-10 inline-flex items-center gap-2 bg-[color:var(--color-gold)] text-[color:var(--color-ink)] px-8 py-4 tracking-wide hover:bg-[color:var(--color-ink)] hover:text-[color:var(--color-gold)] transition-colors">
      Get in Touch
      <span aria-hidden="true">&rarr;</span>
    </a>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</Layout>
