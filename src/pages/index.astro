---
import Layout from '../layouts/Layout.astro';
import ArtImage from '../components/ArtImage.astro';
---
<Layout title="Anna Hileman Art | Colorado Muralist & Commercial Artist">
  <!-- Hero -->
  <section class="relative">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 pt-16 pb-24 lg:pt-24 lg:pb-32">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-6">
          <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-accent)] mb-6">
            Colorado Muralist &amp; Commercial Artist
          </div>
          <h1 class="font-display text-5xl lg:text-7xl leading-[1.05]">
            Custom artwork<br />
            shaped by <em class="italic text-[color:var(--color-accent)]">place, meaning, and story</em>.
          </h1>
          <p class="mt-8 text-lg text-black/70 max-w-lg leading-relaxed">
            Murals, pet portraits, and commissioned pieces for homes, restaurants, and schools across Colorado and beyond.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href="/contact" class="inline-flex items-center gap-2 bg-[color:var(--color-ink)] text-[color:var(--color-paper)] px-6 py-3 text-sm tracking-wide hover:bg-[color:var(--color-accent)] transition-colors">
              Start a Commission
              <span>&rarr;</span>
            </a>
            <a href="/garden-gems" class="inline-flex items-center gap-2 border border-[color:var(--color-ink)]/30 px-6 py-3 text-sm tracking-wide hover:border-[color:var(--color-ink)] transition-colors">
              View Garden Gems
            </a>
          </div>
        </div>
        <div class="lg:col-span-6">
          <ArtImage alt="Threefold Bakery Mural, Breckenridge" src="Threefold-Bakery-Interior-Mural-by-Anna-Hileman-Courtesy1600.jpeg" ratio="landscape" class="shadow-2xl" lightbox={false} />
        </div>
      </div>
    </div>
  </section>

  <!-- Work categories -->
  <section class="border-t border-black/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 py-20">
      <div class="flex items-baseline justify-between mb-12">
        <h2 class="font-display text-4xl">Bodies of Work</h2>
        <div class="text-xs uppercase tracking-[0.2em] text-black/40 hidden md:block">Select a series</div>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          { href: '/restaurants', title: 'Restaurant Art', blurb: 'Custom collections for culinary destinations.', img: 'IMG_5993.jpeg' },
          { href: '/garden-gems', title: 'Garden Gems', blurb: 'Plant-inspired acrylic panels, each rooted in meaning.', img: 'Johannas-Garden-Gem-Full-Edited.jpg' },
          { href: '/murals', title: 'School Murals', blurb: 'Hallways turned into lasting stories—values, mascots, and pride for students and staff.', img: 'Dual-Immersion-Academy-School-Mural-8.jpg' },
          { href: '/portraits', title: 'Pet Portraits', blurb: 'Commissioned acrylic and oil portraits capturing animal personalities.', img: 'BINA-WEB.jpg' },
          { href: '/custom-artwork', title: 'Commercial', blurb: 'Concept-to-installation art for commercial spaces.', img: 'Italian-Boat-Scene.jpg' },
          { href: '/news', title: 'News & Updates', blurb: 'Press, features, and stories from the studio.', img: '5280-Mag-Logo.png' },
        ].map((item) => (
          <a href={item.href} class="group block">
            <ArtImage alt={item.title} src={item.img} ratio="portrait" class="group-hover:opacity-90 transition-opacity" lightbox={false} />
            <div class="mt-4">
              <h3 class="font-display text-2xl group-hover:text-[color:var(--color-accent)] transition-colors">{item.title}</h3>
              <p class="mt-2 text-sm text-black/60 leading-relaxed">{item.blurb}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="bg-[color:var(--color-accent-soft)]/30">
    <div class="max-w-5xl mx-auto px-6 lg:px-10 py-24 text-center">
      <h2 class="font-display text-4xl lg:text-5xl">About Anna</h2>
      <p class="mt-8 text-lg text-black/70 leading-relaxed max-w-2xl mx-auto">
        Colorado-based muralist and commercial artist creating custom, story-driven artwork
        shaped by place, meaning, and the lives of her clients.
      </p>
      <a href="/about" class="mt-10 inline-block text-sm uppercase tracking-[0.2em] border-b border-[color:var(--color-ink)] pb-1 hover:text-[color:var(--color-accent)] hover:border-[color:var(--color-accent)] transition-colors">
        Read her story
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-5xl mx-auto px-6 lg:px-10 py-24 text-center">
    <h2 class="font-display text-4xl lg:text-5xl">Have a project in mind?</h2>
    <p class="mt-6 text-lg text-black/70 max-w-xl mx-auto">
      Anna is currently accepting commissions for murals, pet portraits, and custom commercial work.
    </p>
    <a href="/contact" class="mt-10 inline-flex items-center gap-2 bg-[color:var(--color-ink)] text-[color:var(--color-paper)] px-8 py-4 tracking-wide hover:bg-[color:var(--color-accent)] transition-colors">
      Get in Touch
      <span>&rarr;</span>
    </a>
  </section>
</Layout>
