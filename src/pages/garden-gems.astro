---
import Layout from '../layouts/Layout.astro';

const hero = {
  src: 'Johannas-Garden-Gem-Full-Edited.jpg',
  alt: "Johanna's Garden Gem",
};

type GalleryItem = {
  src: string;
  alt: string;
  /** Wide panorama: span 2 of 3 grid columns on lg (not full width). */
  span2Lg?: boolean;
};

/** Remaining pieces: CSS Grid (1 / 2 / 3 columns), natural image heights. */
const gallery: GalleryItem[] = [
  { src: 'Cali-Fig-24x36-1.jpg', alt: 'Cali Fig, 24x36' },
  { src: 'Drippy-Fig-24x36-1.jpg', alt: 'Drippy Fig, 24x36' },
  { src: 'Drippy-Fig-Installed-24x36-1.jpg', alt: 'Drippy Fig installed' },
  { src: 'Iris-Fig-Mock-Up.jpg', alt: 'Iris Fig mockup' },
  { src: 'Iris-Gem-30x72-1.jpg', alt: 'Iris Gem, 30x72', span2Lg: true },
  { src: 'Iris-Gem-Detail-1.jpg', alt: 'Iris Gem detail' },
  { src: 'Iris-Gem-Detail-2.jpg', alt: 'Iris Gem detail' },
  { src: 'Iris-Gem-Detail-3.jpg', alt: 'Iris Gem detail' },
];

const heroHref = `/images/${hero.src}`;
---

<Layout title="Garden Gems | Anna Hileman Art">
  <section class="max-w-5xl mx-auto px-6 lg:px-10 py-20 text-center">
    <div class="text-xs uppercase tracking-[0.3em] text-[color:var(--color-accent)] mb-6">A Series</div>
    <h1 class="font-display text-6xl lg:text-7xl">Garden Gems</h1>
    <p class="mt-10 text-lg text-black/70 max-w-2xl mx-auto leading-relaxed">
      Garden Gems are original, plant-inspired works created in acrylic on custom-built panels.
      Each piece is rooted in meaning, drawing from the natural world and the stories of the
      people who commission them.
    </p>
  </section>

  <!-- Hero: same max width and padding as mosaic gallery below -->
  <section
    class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-10"
    aria-label="Featured Garden Gem"
  >
    <button
      type="button"
      class="block w-full cursor-zoom-in overflow-hidden rounded-lg border-0 bg-[color:var(--color-accent-soft)] p-0 text-left shadow-sm ring-1 ring-black/5 transition-shadow hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
      data-lightbox={heroHref}
      data-lightbox-alt={hero.alt}
      aria-label={`View larger: ${hero.alt}`}
    >
      <img
        src={heroHref}
        alt=""
        class="pointer-events-none block h-auto w-full"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </button>
  </section>

  <!-- Gallery grid: lg uses 3 columns; wide panoramas can span 2 -->
  <section class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-10 pb-24 pt-6 lg:pt-10">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3 lg:gap-5">
      {gallery.map((g) => {
        const href = `/images/${g.src}`;
        return (
          <div
            class:list={[
              'min-w-0',
              g.span2Lg && 'lg:col-span-2',
            ]}
          >
            <button
              type="button"
              class="block w-full cursor-zoom-in overflow-hidden rounded-lg border-0 bg-[color:var(--color-accent-soft)] p-0 text-left shadow-sm ring-1 ring-black/5 transition-shadow hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-[color:var(--color-accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[color:var(--color-paper)]"
              data-lightbox={href}
              data-lightbox-alt={g.alt}
              aria-label={`View larger: ${g.alt}`}
            >
              <img
                src={href}
                alt=""
                class="pointer-events-none block h-auto w-full"
                loading="lazy"
                decoding="async"
              />
            </button>
          </div>
        );
      })}
    </div>
  </section>

  <section class="bg-[color:var(--color-accent-soft)]/30">
    <div class="max-w-3xl mx-auto px-6 lg:px-10 py-20 text-center">
      <h2 class="font-display text-4xl">About the Series</h2>
      <p class="mt-8 text-lg text-black/70 leading-relaxed">
        Each Garden Gem begins with a conversation. What plant speaks to you? What root system,
        what season, what memory? The piece grows from there, always with signature color,
        texture, and Anna's hand-built panel.
      </p>
      <a href="/contact" class="mt-10 inline-flex items-center gap-2 bg-[color:var(--color-ink)] text-[color:var(--color-paper)] px-8 py-4 tracking-wide hover:bg-[color:var(--color-accent)] transition-colors">
        Inquire About a Garden Gem
        <span>&rarr;</span>
      </a>
    </div>
  </section>
</Layout>
