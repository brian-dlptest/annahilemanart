# Cloudflare Pages: set these under Settings → Environment variables (per project).

# Canonical base URL for sitemap, RSS, and <link rel="canonical">.
# Staging Pages project: https://staging.annahileman.com
# Production Pages project: https://annahileman.com
PUBLIC_SITE_URL=https://annahileman.com

# Formspree form ID (path segment after /f/). Create a form at https://formspree.io
PUBLIC_FORMSPREE_FORM_ID=
